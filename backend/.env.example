# ─── Core ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production
API_PUBLIC_BASE_URL=http://localhost:8000   # public HTTPS URL in staging/prod (used for webhooks + media WS)
DATABASE_URL=postgresql+asyncpg://elets:elets@localhost:5432/elets_salescall
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]
ORG_TIMEZONE=Asia/Kolkata
RUN_WORKERS=true                   # run campaign runner / reminders inside the API process

# Secrets — generate real values for every non-dev environment:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
JWT_SECRET=change-me-dev-only-jwt-secret
FIELD_ENCRYPTION_KEY=              # Fernet key; empty = derived from JWT_SECRET (dev only)
BLIND_INDEX_KEY=change-me-dev-only-blind-index-key
WEBHOOK_SIGNING_SECRET=change-me-dev-only-webhook-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ─── Telephony (pick one; leave empty to disable calling) ─────────────────────
TELEPHONY_PROVIDER=                # exotel | twilio | plivo | knowlarity
TELEPHONY_CALLER_ID=               # your virtual number / ExoPhone in E.164, e.g. +918047xxxxxx
CALL_TIME_LIMIT_SECONDS=3600

EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.exotel.com    # api.in.exotel.com for the Mumbai cluster
EXOTEL_AI_APP_ID=                  # Exotel flow (app) id containing the Voicebot applet

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

KNOWLARITY_API_KEY=
KNOWLARITY_AUTH_TOKEN=
KNOWLARITY_K_NUMBER=
KNOWLARITY_BASE_URL=https://kpi.knowlarity.com/Basic/v1/account

# ─── AI voice agent ───────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_REALTIME_EFFORT=low            # live conversation turns (latency-sensitive)
LLM_ANALYSIS_EFFORT=medium         # post-call intelligence

STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_DEFAULT_VOICE_ID=

# ─── Push notifications (Firebase Cloud Messaging HTTP v1) ────────────────────
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=          # path to the service-account JSON (never commit it)

# ─── Seed data (python -m app.seed) ───────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@elets.local
SEED_DEFAULT_PASSWORD=Elets@12345
